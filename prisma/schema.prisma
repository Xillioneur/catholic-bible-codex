generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Translation {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  language    String
  description String?
  verses      Verse[]
}

model Book {
  id             String    @id @default(cuid())
  name           String    @unique
  shortName      String?   @unique
  order          Int       @unique
  testament      Testament
  isDeuterocanon Boolean   @default(false)
  chapters       Chapter[]
}

model Chapter {
  id     String  @id @default(cuid())
  number Int
  bookId String
  book   Book    @relation(fields: [bookId], references: [id])
  verses Verse[]

  @@unique([bookId, number])
}

model Verse {
  id            String      @id @default(cuid())
  number        Int
  text          String
  chapterId     String
  translationId String
  globalOrder   Int         @unique
  chapter       Chapter     @relation(fields: [chapterId], references: [id])
  translation   Translation @relation(fields: [translationId], references: [id])

  @@unique([chapterId, number, translationId])
  @@index([globalOrder])
}

model DailyReading {
  id       String    @id @default(cuid())
  date     DateTime  @unique
  season   String
  readings Reading[]
}

model Reading {
  id             String       @id @default(cuid())
  type           String
  reference      String
  text           String
  dailyReadingId String
  dailyReading   DailyReading @relation(fields: [dailyReadingId], references: [id])
}

enum Testament {
  OLD
  NEW
}
